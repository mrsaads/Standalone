# Copy to .env.local for local development. In production (Render), set these in the service's
# environment variables instead — see render.yaml and the handover's credential checklist for
# where each value comes from.

# ── Supabase (Auth + Postgres) ────────────────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → Database → Connection string → "Transaction" pooler (port 6543), with your
# database password filled in. Must include ?sslmode=require if your Supabase project enforces it.
SUPABASE_DB_URL=
# Same two public values as above, exposed to the browser for the client-side Supabase SDK.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Access control ────────────────────────────────────────────────────────────────────────────
# Comma-separated emails that get admin (unlimited) access, e.g. saadkkhalidd@gmail.com
ADMIN_EMAILS=

# ── App origin (used by the delivery worker to build the "audit ready" email's report link) ───
# Not needed on Render — it reads RENDER_EXTERNAL_URL automatically (see render.yaml). Needed for
# local dev / any other host, e.g. http://localhost:3000 or https://your-domain.com (no trailing
# slash).
APP_ORIGIN=

# ── AI generation ─────────────────────────────────────────────────────────────────────────────
AI_PROVIDER=openai
AI_MODEL=gpt-5.2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_REASONING_EFFORT=medium
AI_WEB_RESEARCH=true

# ── Google Drive (owner-only OAuth, drive.file scope) ─────────────────────────────────────────
# From a Google Cloud OAuth client (Web application type) — see the handover's setup steps.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on that OAuth client:
# https://<your-app-domain>/api/admin/drive/callback
GOOGLE_OAUTH_REDIRECT_URI=
# Encrypts the stored Drive refresh token. Generate it with EXACTLY this command and paste its
# output as-is — lib/crypto.ts rejects anything shorter than that command's 44-character output:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DRIVE_TOKEN_ENCRYPTION_KEY=

# ── Resend (application notification emails) ─────────────────────────────────────────────────
RESEND_API_KEY=
# Must be on a domain verified in Resend before customer launch; resend.dev works unverified for
# testing but only delivers to the Resend account's own email address.
RESEND_FROM_NOTIFICATIONS="Improvexus <notifications@yourdomain.com>"
RESEND_FROM_PROMOTIONAL="Improvexus <news@yourdomain.com>"
