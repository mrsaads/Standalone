# Copy to .env.local for local development. In production (Render), set these in the service's
# environment variables instead — see render.yaml and the handover's credential checklist for
# where each value comes from.

# ── Supabase (Auth + Postgres) ────────────────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → Database → Connection string → "Transaction" pooler (port 6543), with your
# database password filled in. Must include ?sslmode=require if your Supabase project enforces it.
SUPABASE_DB_URL=
# Same two public values as above, exposed to the browser for the client-side Supabase SDK.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Access control ────────────────────────────────────────────────────────────────────────────
# Comma-separated emails that get admin (unlimited) access, e.g. saadkkhalidd@gmail.com
ADMIN_EMAILS=

# ── App origin (used by the delivery worker to build the "audit ready" email's report link) ───
# Not needed on Render — it reads RENDER_EXTERNAL_URL automatically (see render.yaml). Needed for
# local dev / any other host, e.g. http://localhost:3000 or https://your-domain.com (no trailing
# slash).
APP_ORIGIN=

# ── AI generation ─────────────────────────────────────────────────────────────────────────────
AI_PROVIDER=openai
AI_MODEL=gpt-5.2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_REASONING_EFFORT=medium
AI_WEB_RESEARCH=true

# ── Google Drive (owner-only OAuth, drive.file scope) ─────────────────────────────────────────
# From a Google Cloud OAuth client (Web application type) — see the handover's setup steps.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" on that OAuth client:
# https://<your-app-domain>/api/admin/drive/callback
GOOGLE_OAUTH_REDIRECT_URI=
# Encrypts the stored Drive refresh token. Generate it with EXACTLY this command and paste its
# output as-is — lib/crypto.ts rejects anything shorter than that command's 44-character output:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DRIVE_TOKEN_ENCRYPTION_KEY=

# ── Resend (application notification emails) ─────────────────────────────────────────────────
RESEND_API_KEY=
# Must be on a domain verified in Resend before customer launch; resend.dev works unverified for
# testing but only delivers to the Resend account's own email address.
RESEND_FROM_NOTIFICATIONS="Improvexus <notifications@yourdomain.com>"
RESEND_FROM_PROMOTIONAL="Improvexus <news@yourdomain.com>"

# ── Security: browser limits & sessions (all optional — defaults shown) ─────────────────────
# Signs the per-browser cookie used for the "10 emails per browser" rule. Falls back to a value
# derived from SUPABASE_SERVICE_ROLE_KEY if unset. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BROWSER_ID_SECRET=
# Auth emails (signup verification, resend, password reset) per browser before it is locked.
AUTH_EMAIL_BROWSER_LIMIT=10
# How long a browser (or network / recipient address) stays locked after hitting its limit.
AUTH_EMAIL_LOCK_MINUTES=30
# Backstops that don't depend on the browser cookie (clearing cookies doesn't reset these).
AUTH_EMAIL_IP_LIMIT=30
AUTH_EMAIL_RECIPIENT_LIMIT=5
# Wrong-password lockout.
AUTH_LOGIN_BROWSER_FAILURES=10
AUTH_LOGIN_ACCOUNT_FAILURES=10
AUTH_LOGIN_LOCK_MINUTES=15
# Signed-in sessions end after this much inactivity, and after this long regardless.
SESSION_IDLE_MINUTES=720
SESSION_MAX_HOURS=168

# ── Public site & SEO (all optional) ─────────────────────────────────────────────────────────
# The address search engines should treat as the real one. Set this the day a custom domain is
# connected (e.g. https://www.improvexus.com) and redeploy — canonical URLs, the sitemap and
# robots.txt are all built from it. Until then the Render URL is used.
NEXT_PUBLIC_SITE_URL=
# Paste the verification codes from Google Search Console / Bing Webmaster Tools (just the code).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Real business details for search-engine structured data. Leave blank rather than invent them.
NEXT_PUBLIC_BUSINESS_CITY=
NEXT_PUBLIC_BUSINESS_REGION=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_EMAIL=
# Comma-separated https:// links to your real profiles (LinkedIn page, Upwork agency page…).
NEXT_PUBLIC_BUSINESS_PROFILES=
# City pages are indexable by default. Set to "false" to keep them for visitors but ask search
# engines not to index them (use this if Search Console reports them as thin or duplicate).
SEO_INDEX_CITY_PAGES=true

# ---- Enquiry form abuse limits (optional; these are the defaults) --------------------------------
# Accepted enquiries per browser / per network address in one hour, and how long the lock lasts.
LEAD_BROWSER_LIMIT=5
LEAD_IP_LIMIT=20
LEAD_LOCK_MINUTES=30

# Dedicated Upwork browser worker (see docs/upwork-browser.md).
# Set URL only after the worker has an authorized session and a verified live capture.
# Both app and worker use the same private token. Never expose these as NEXT_PUBLIC variables.
UPWORK_BROWSER_URL=
UPWORK_BROWSER_TOKEN=
# Worker only: absolute private directory OUTSIDE the checkout. Do not commit browser sessions.
UPWORK_BROWSER_SESSION_DIR=
# Worker only: Playwright browser location, if installed outside its default cache.
# PLAYWRIGHT_BROWSERS_PATH=/workspace/.cache/ms-playwright

# Render worker: temporary operator desktop. Use a separate private 32+ character password.
UPWORK_BROWSER_ADMIN_PASSWORD=
UPWORK_BROWSER_LOGIN_MODE=false
# Render Docker image sets HEADED=true, HOST=0.0.0.0 and session path /var/data/upwork-session.

# ---- Connect Upwork: Upwork's OFFICIAL API (see docs/upwork-api.md) ------------------------------
# Leave blank until Upwork has approved an API key for this product. Blank = the "Connect Upwork"
# button is hidden and /api/upwork/* does nothing. The customer signs in on upwork.com and approves
# read access to their OWN profile; no password, scraping or browser session is involved.
UPWORK_API_CLIENT_ID=
UPWORK_API_CLIENT_SECRET=
# Optional. Defaults to <NEXT_PUBLIC_SITE_URL>/api/upwork/callback. Must equal the callback saved in the
# Upwork key settings, character for character.
UPWORK_API_REDIRECT_URI=
# Optional overrides (https upwork.com hosts only), to be confirmed with the first real key:
# UPWORK_API_AUTHORIZE_URL=https://www.upwork.com/ab/account-security/oauth2/authorize
# UPWORK_API_TOKEN_URL=https://www.upwork.com/api/v3/oauth2/token
# UPWORK_API_GRAPHQL_URL=https://api.upwork.com/graphql
# Successful Upwork sign-ins per network address per hour (each one spends our Upwork API allowance).
UPWORK_CONNECT_IP_LIMIT=20
